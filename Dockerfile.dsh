# ==============================================================================
# DeepSeek Harness (DSH) Optimized Layer-Cached Dockerfile (User: dsh)
# ==============================================================================
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production
ENV HOME=/home/dsh
ENV DSH_HOME=/home/dsh/.dsh
ENV DEEPSEEK_BASE_URL=http://127.0.0.1:1919/v1
ENV DEEPSEEK_API_KEY=dummy-key
ENV FREETOKEN_API_KEY=dummy-key
ENV OPENAI_API_BASE=http://127.0.0.1:1919/v1
ENV OPENAI_API_KEY=dummy-key

# ------------------------------------------------------------------------------
# Layer 1: Base System Utilities, Bubblewrap & nono CLI (Cached permanently)
# ------------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    bubblewrap \
    git \
    curl \
    wget \
    procps \
    ca-certificates \
    tar \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Install nono CLI globally
RUN curl -fsSL https://nono.sh/install.sh | NONO_INSTALL_DIR=/usr/local/bin sh

# ------------------------------------------------------------------------------
# Layer 2: Create Dedicated 'dsh' Non-Root User & nono state directory
# ------------------------------------------------------------------------------
RUN userdel -r node 2>/dev/null || true && \
    groupadd -g 1000 dsh && \
    useradd -u 1000 -g dsh -m -s /bin/bash -d /home/dsh dsh && \
    mkdir -p /home/dsh/.dsh /home/dsh/.npm /workspace/project /var/nono && \
    chown -R dsh:dsh /home/dsh /workspace /var/nono

WORKDIR /workspace/project

# ------------------------------------------------------------------------------
# Layer 3: Static Agent Configuration & Credentials (Cached permanently)
# ------------------------------------------------------------------------------
COPY --chown=dsh:dsh configs/dsh/settings.yaml /home/dsh/.dsh/settings.yaml
COPY --chown=dsh:dsh configs/dsh/.credentials.yaml /home/dsh/.dsh/.credentials.yaml
COPY --chmod=755 configs/dsh/dsh-entrypoint.sh /usr/local/bin/dsh-entrypoint.sh
RUN chmod 600 /home/dsh/.dsh/.credentials.yaml

EXPOSE 8080

# ------------------------------------------------------------------------------
# Layer 4 (TOP LAYER ONLY): DSH Package Installation (~15 MB, rebuilds in ~3s)
# ------------------------------------------------------------------------------
ARG DSH_VERSION=0.1.1-rc.2
RUN npm install -g @deepseek-ai/dsh@${DSH_VERSION} --omit=dev --no-audit --no-fund

# Switch to unprivileged dsh user
USER dsh

ENTRYPOINT ["/usr/local/bin/dsh-entrypoint.sh"]
CMD ["--port", "8080", "--no-open"]

FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production

# Install system dependencies (Bubblewrap for sandboxing, Git, Curl, Bash)
RUN apt-get update && apt-get install -y --no-install-recommends \
    bubblewrap \
    git \
    curl \
    procps \
    ca-certificates \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Install DeepSeek Harness globally
RUN npm install -g @deepseek-ai/dsh@0.1.1-rc.2

# Setup default DSH directory and configuration
RUN mkdir -p /root/.dsh /workspace/project

# Copy default configuration (pointing to 127.0.0.1:1919/v1 with network_mode: host)
COPY configs/dsh/settings.yaml /root/.dsh/settings.yaml

# Set default working directory
WORKDIR /workspace/project

# Expose DSH Web UI port
EXPOSE 8080

# Default entrypoint: launch DSH Web UI
ENTRYPOINT ["dsh", "web"]
CMD ["--port", "8080", "--no-open"]

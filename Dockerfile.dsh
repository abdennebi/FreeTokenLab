# ==============================================================================
# DeepSeek Harness (DSH) Optimized Layer-Cached Dockerfile
# ==============================================================================
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production
ENV DSH_HOME=/root/.dsh
ENV DEEPSEEK_BASE_URL=http://127.0.0.1:1919/v1
ENV DEEPSEEK_API_KEY=dummy-key
ENV FREETOKEN_API_KEY=dummy-key
ENV OPENAI_API_BASE=http://127.0.0.1:1919/v1
ENV OPENAI_API_KEY=dummy-key

# ------------------------------------------------------------------------------
# Layer 1: Base System Utilities & Bubblewrap Sandbox (Cached permanently)
# ------------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    bubblewrap \
    git \
    curl \
    wget \
    procps \
    ca-certificates \
    bash \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# Layer 2: Directories & Workspace Setup (Cached permanently)
# ------------------------------------------------------------------------------
RUN mkdir -p /root/.dsh /workspace/project /root/.npm
WORKDIR /workspace/project

# ------------------------------------------------------------------------------
# Layer 3: Static Agent Configuration & Credentials (Cached permanently)
# ------------------------------------------------------------------------------
COPY configs/dsh/settings.yaml /root/.dsh/settings.yaml
COPY configs/dsh/.credentials.yaml /root/.dsh/.credentials.yaml
RUN chmod 600 /root/.dsh/.credentials.yaml

EXPOSE 8080

# ------------------------------------------------------------------------------
# Layer 4 (TOP LAYER ONLY): DSH Package Installation (~15 MB, rebuilds in ~3s)
# ------------------------------------------------------------------------------
ARG DSH_VERSION=0.1.1-rc.2
RUN npm install -g @deepseek-ai/dsh@${DSH_VERSION} --omit=dev --no-audit --no-fund

ENTRYPOINT ["dsh", "web"]
CMD ["--port", "8080", "--no-open"]
